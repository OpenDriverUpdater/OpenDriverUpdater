    <AssemblyName>OpenDriverUpdater.Infrastructure</AssemblyName>
    <Description>Infrastructure layer — Windows API, networking, storage, and installation. Now with multi-target support for Linux CLI builds.</Description>
  </PropertyGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\OpenDriverUpdater.Core\OpenDriverUpdater.Core.csproj" />
  </ItemGroup>
 
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
  </ItemGroup>
 
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
 
</Project>
