<Application
    x:Class="OpenDriverUpdater.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary xmlns:converters="using:OpenDriverUpdater.App.Converters">
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:ResourceConverter x:Key="ResourceConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToInvertedVisibilityConverter" IsInverted="True" />
            <converters:DeviceClassToIconConverter x:Key="DeviceClassToIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
