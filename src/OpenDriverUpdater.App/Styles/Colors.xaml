<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette -->
    <Color x:Key="OduPrimary">#0863D5</Color>
    <Color x:Key="OduAccent">#2C8BCD</Color>
    <Color x:Key="OduSurface">#0D1625</Color>
    <Color x:Key="OduSurfaceAlt">#0A376C</Color>
    <Color x:Key="OduText">#B6D7F0</Color>
    <Color x:Key="OduSuccess">#81BA6C</Color>
    <Color x:Key="OduWarning">#35B2CD</Color>
    <Color x:Key="OduDanger">#F43F5E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource OduPrimary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource OduAccent}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource OduSurface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource OduSurfaceAlt}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource OduText}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource OduSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource OduWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource OduDanger}" />

</ResourceDictionary>
