<Page
    x:Class="OpenDriverUpdater.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenDriverUpdater.App.ViewModels">

    <Page.DataContext>
        <vm:DevicesViewModel />
    </Page.DataContext>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detected Devices" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{Binding Devices}" SelectionMode="None" Margin="0,16,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4" Padding="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon Wrapper -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding Class, Converter={StaticResource DeviceClassToIconConverter}}" 
                                          FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18" Opacity="0.8" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Manufacturer}" Opacity="0.5" FontSize="11" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Class}" VerticalAlignment="Center" Opacity="0.7" FontSize="13" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstalledDriverVersion}" FontSize="13" />
                                <TextBlock Text="Version" FontSize="10" Opacity="0.4" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstalledProvider}" FontSize="13" Opacity="0.8" />
                                <TextBlock Text="Provider" FontSize="10" Opacity="0.4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
