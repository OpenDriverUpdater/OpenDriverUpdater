<Page
    x:Class="OpenDriverUpdater.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenDriverUpdater.App.ViewModels"
    Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <vm:DashboardViewModel />
    </Page.DataContext>

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="32">
            <!-- Hero Section -->
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="16" Padding="40">
                <Grid ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Health Ring/Status -->
                    <Grid Width="160" Height="160">
                        <ProgressRing IsActive="False" Value="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                      BorderThickness="12" Foreground="{Binding StatusBrush, Converter={StaticResource ResourceConverter}}" />
                        <FontIcon Glyph="&#xE930;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="64" 
                                  Foreground="{Binding StatusBrush, Converter={StaticResource ResourceConverter}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="System Status" Opacity="0.6" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding SystemHealthStatus}" FontSize="48" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats & Quick Info -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Devices" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeviceCount}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Updates" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Last Scan" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastScanText}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Scan Now" Command="{Binding ScanCommand}" Style="{StaticResource AccentButtonStyle}" Padding="24,12" />
                <Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}" Padding="24,12" />
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading}" />
        </StackPanel>
    </ScrollViewer>
</Page>
