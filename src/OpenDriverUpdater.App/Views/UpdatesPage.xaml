<Page
    x:Class="OpenDriverUpdater.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenDriverUpdater.App.ViewModels">

    <Page.DataContext>
        <vm:UpdatesViewModel />
    </Page.DataContext>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Available Updates" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Check Updates" Command="{Binding CheckCommand}" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Download All" Command="{Binding DownloadAllCommand}" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{Binding Recommendations}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4" Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DeviceId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" VerticalAlignment="Center" Opacity="0.6" />
                            <TextBlock Grid.Column="2" Text="{Binding CandidateVersion}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{Binding RecommendationType}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding TrustScore.Level}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
