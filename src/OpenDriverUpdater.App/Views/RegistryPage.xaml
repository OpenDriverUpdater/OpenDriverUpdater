<Page
    x:Class="OpenDriverUpdater.App.Views.RegistryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registry Report" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="Read-only"
                 Message="This page only reads the registry and never changes it. It lists startup programs and installed programs that point to files that no longer exist. Fix them in Windows Settings rather than by editing the registry." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap" />

        <ListView Grid.Row="4" ItemsSource="{Binding Findings}" SelectionMode="None" Margin="0,8,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4" Padding="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon Wrapper -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18" Opacity="0.8" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindText}" Opacity="0.5" FontSize="11" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{Binding MissingPath}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="Missing file" FontSize="10" Opacity="0.4" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{Binding KeyPath}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding ValueText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="Registry location" FontSize="10" Opacity="0.4" />
                                </StackPanel>

                                <TextBlock Text="{Binding Advice}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right" MinWidth="180">
                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Right"
                                        BorderThickness="1" BorderBrush="{StaticResource WarningBrush}">
                                    <TextBlock Text="Missing file" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <Button Content="{Binding SettingsButtonText}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" />
                                <Button Content="Copy registry path" Command="{Binding CopyRegistryPathCommand}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding CopyFeedback}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
