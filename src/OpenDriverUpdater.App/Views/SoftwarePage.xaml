<Page
    x:Class="OpenDriverUpdater.App.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Installed Software" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap" />

        <ListView Grid.Row="3" ItemsSource="{Binding Apps}" SelectionMode="None" Margin="0,8,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon Wrapper -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B8;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18" Opacity="0.8" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding App.Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding App.Id}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding App.InstalledVersion}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Opacity="0.5" VerticalAlignment="Center"
                                                  Visibility="{Binding NeedsUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding App.AvailableVersion}" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding NeedsUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="Version" FontSize="10" Opacity="0.4" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceText}" FontSize="13" Opacity="0.8" />
                                    <TextBlock Text="Source" FontSize="10" Opacity="0.4" />
                                </StackPanel>

                                <!-- Update status + Update button -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" MinWidth="200" HorizontalAlignment="Right">
                                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                                            BorderThickness="1"
                                            BorderBrush="{Binding UpdateStatusBrush, Converter={StaticResource ResourceConverter}}"
                                            ToolTipService.ToolTip="{Binding UpdateStatusTooltip}"
                                            Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding UpdateStatusBrush, Converter={StaticResource ResourceConverter}}" />
                                    </Border>
                                    <Button Content="Update" Command="{Binding UpdateCommand}"
                                            Visibility="{Binding NeedsUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Update progress / result -->
                            <StackPanel Spacing="6" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
